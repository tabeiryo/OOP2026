<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報"
        Height="600"
        Width="500">

    <Grid>
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <ComboBox
                x:Name="CityComboBox"
                Width="200"
                Margin="0,0,0,10"/>

            <TextBlock
                Text="天気予報"
                FontSize="24"
                FontWeight="Bold"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Name="WeatherTextBlock"
                Text="天気取得中..."
                FontSize="18"
                Margin="0,5"/>

            <TextBlock
                x:Name="TemperatureTextBlock"
                Text="気温取得中..."
                FontSize="18"
                Margin="0,5"/>

            <TextBlock
                x:Name="HumidityTextBlock"
                Text="湿度取得中..."
                FontSize="18"
                Margin="0,5"/>

            <TextBlock
                x:Name="WindSpeedTextBlock"
                Text="風速取得中..."
                FontSize="18"
                Margin="0,5"/>

            <DataGrid
                x:Name="ForecastDataGrid"
                Width="450"
                Height="250"
                Margin="0,10,0,0"
                AutoGenerateColumns="False"
                IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="日付"
                        Binding="{Binding Date}" />

                    <DataGridTextColumn
                        Header="天気"
                        Binding="{Binding Weather}" />

                    <DataGridTextColumn
                        Header="最高気温"
                        Binding="{Binding MaxTemperature}" />

                    <DataGridTextColumn
                        Header="最低気温"
                        Binding="{Binding MinTemperature}" />

                    <DataGridTextColumn
                        Header="降水確率"
                        Binding="{Binding PrecipitationProbability}" />

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>
    </Grid>

</Window>