@model List<MvcBasicSample.Models.Product>

@{
    ViewData["Title"] = "商品情報";
    string name = "田中";
    int sum = 0;

}
<h1> 商品情報 </h1>
<ul>
    @foreach (var i in Model)
    {
        <li>@i.Name @i.Price    円</li>
        @sum+=i.Price
    }

    <li>@sum</li>
</ul>


